# Third-party native binaries for the desktop runtime are redistribution
# artifacts, not project source; keep the repo lean. Licenses stay tracked.
desktopRuntime/*.dll
desktopRuntime/*.so
desktopRuntime/*.so.1
desktopRuntime/*.jar
desktopRuntime/*.class
desktopRuntime/resources/

# Runtime state (never commit)
desktopRuntime/_eagstorage*
desktopRuntime/downloads/*
desktopRuntime/screenshots/*
desktopRuntime/crash-reports/*
desktopRuntime/filesystem/*
desktopRuntime/hs_err_*

# Proprietary game source (NEVER commit)
port-src/minecraft-26.2/
reference/build-inputs/*.jar

# Output dist is reproducible; ignore so it stays tracked-optional
dist/

